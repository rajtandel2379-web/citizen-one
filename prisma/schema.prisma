datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id
  name            String
  email           String         @unique
  phone           String
  location        String?
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastSeenAt      DateTime       @default(now())
  termsAcceptedAt DateTime       @default(now())
  termsVersion    String
  ips             UserIp[]
  activities      UserActivity[]
  comments        Comment[]
  otps            EmailOtp[]

  @@map("users")
}

model EmailOtp {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@map("email_otps")
}

model UserIp {
  id          String   @id @default(cuid())
  userId      String
  address     String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_ips")
}

model UserActivity {
  id     String   @id
  userId String
  type   String
  detail String
  ip     String
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_activities")
}

model Article {
  id            String           @id
  category      String
  categoryLabel String
  title         String
  summary       String
  locations     String[]         @default([])
  categories    String[]         @default([])
  tags          String[]         @default([])
  status        String           @default("published")
  sources       Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sections      ArticleSection[]
  comments      Comment[]

  @@map("articles")
}

model ArticleSection {
  id        String           @id @default(cuid())
  articleId String
  heading   String
  body      String           @default("")
  html      String?
  steps     String[]         @default([])
  checklist String[]         @default([])
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  channels  SectionChannel[]

  @@index([articleId])
  @@map("article_sections")
}

model SectionChannel {
  id        String         @id @default(cuid())
  sectionId String
  name      String
  contact   String
  url       String?
  section   ArticleSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("section_channels")
}

model Comment {
  id            String   @id
  articleId     String
  userId        String?
  name          String
  text          String
  ip            String
  editedByAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@index([userId])
  @@map("comments")
}

model CommentLock {
  articleId String   @id
  lockedAt  DateTime @default(now())

  @@map("comment_locks")
}

model AdminState {
  key   String @id
  value Json

  @@map("admin_state")
}

model Tag {
  id    String @id
  type  String // "location" or "category"
  label String

  @@map("tags")
}

